					"import os\r\n",
					"from azure.keyvault.secrets import SecretClient\r\n",
					"from azure.identity import DefaultAzureCredential\r\n",
					"import requests\r\n",
					"import json\r\n",
					"\r\n",
					"kvName = 'kv-cdw-nonprod'\r\n",
					"kvUri = f'https://{kvName}.vault.azure.net'\r\n",
					"\r\n",
					"credential = DefaultAzureCredential(exclude_shared_token_cache_credential=True)\r\n",
					"client = SecretClient(vault_url=kvUri, credential=credential)\r\n",
					"\r\n",
					"unSrcApi = client.get_secret(\"un-peloton-api\").value\r\n",
					"pwSrcApi = client.get_secret(\"pw-peloton-api\").value\r\n",
					"srcSession = requests.Session()\r\n",
					"\r\n",
					"apiCredentials = {'username_or_email': unSrcApi, 'password': pwSrcApi}\r\n",
					"apiSession.post('https://api.onepeloton.com/auth/login', json=srcCredentials)\r\n",
					"\r\n",
					"apiResponse = apiSession.get('https://api.onepeloton.com/api/me')\r\n",
					"print(json.loads(apiResponse))"
				],
				"execution_count": 2
