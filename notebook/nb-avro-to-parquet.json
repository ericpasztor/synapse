				"source": [
					"## Specify Storage Account, Avro Schema"
				]
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"accountName = 'adlsfhirnonprod'\r\n",
					"basePath = \"abfss://raw@\" + accountName + \".dfs.core.windows.net/\"\r\n",
					"\r\n",
					"avroSchema = '''{\r\n",
					"  \"type\" : \"record\",\r\n",
					"  \"name\" : \"GenericFromIRecord0\",\r\n",
					"  \"namespace\" : \"Microsoft.Streaming.Avro\",\r\n",
					"  \"fields\" : [ {\r\n",
					"    \"name\" : \"createdat\",\r\n",
					"    \"type\" : [ \"null\", \"string\" ]\r\n",
					"  }, {\r\n",
					"    \"name\" : \"topic\",\r\n",
					"    \"type\" : [ \"null\", \"string\" ]\r\n",
					"  }, {\r\n",
					"    \"name\" : \"sentimentscore\",\r\n",
					"    \"type\" : [ \"null\", \"long\" ]\r\n",
					"  }, {\r\n",
					"    \"name\" : \"eventprocessedutctime\",\r\n",
					"    \"type\" : [ \"null\", \"string\" ]\r\n",
					"  }, {\r\n",
					"    \"name\" : \"partitionid\",\r\n",
					"    \"type\" : [ \"null\", \"long\" ]\r\n",
					"  }, {\r\n",
					"    \"name\" : \"eventenqueuedutctime\",\r\n",
					"    \"type\" : [ \"null\", \"string\" ]\r\n",
					"  } ]\r\n",
					"}\r\n",
					"'''"
				],
				"execution_count": 33
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"## Read Avro file, Apply Schema and Write Spark Dataframe as Parquet"
				]
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"df = spark.read.format('avro').options(avroSchema=avroSchema).load(basePath + \"twitter.avro\")\r\n",
					"df.write.mode(\"overwrite\").parquet(basePath + \"twitter.parquet\")"
				],
				"execution_count": 34
			},
			{
				"cell_type": "markdown",
				"metadata": {
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"## Read Parquet File as a Spark Dataframe and Display"
				]
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					},
					"collapsed": false
				},
				"source": [
					"df = spark.read.parquet(basePath + \"twitter.parquet\")\r\n",
					"display(df)"
				],
