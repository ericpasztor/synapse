				"source": [
					"#Import Python packages supporting REST API processing \r\n",
					"import requests\r\n",
					"import json\r\n",
					"\r\n",
					"#Define Azure Linked Services and Source Parameters\r\n",
					"kvName = 'kv-cdw-nonprod'\r\n",
					"lsKvName = 'lsakvcdwnonprod'\r\n",
					"srcName = 'peloton'\r\n",
					"baseUrl = 'https://api.onepeloton.com'\r\n",
					"\r\n",
					"#Get Source Credentials from Key Vault\r\n",
					"unSrcApi = mssparkutils.credentials.getSecret(kvName,f\"un-{srcName}-api\", lsKvName)\r\n",
					"pwSrcApi = mssparkutils.credentials.getSecret(kvName,f\"pw-{srcName}-api\", lsKvName)\r\n",
					"\r\n",
					"#Create API Session and Authenticate\r\n",
					"apiSession = requests.Session()\r\n",
					"apiCredentials = {'username_or_email': unSrcApi, 'password': pwSrcApi}\r\n",
					"userSession = apiSession.post(f'{baseUrl}/auth/login', json=apiCredentials)\r\n",
					"\r\n",
					"#Read API Session Response\r\n",
					"loginResponse = json.loads(userSession.text)\r\n",
					"sessionId = loginResponse[\"session_id\"]\r\n",
					"userId = loginResponse[\"user_id\"]"
				],
				"execution_count": 6
			},
