				"source": [
					"import com.microsoft.spark.sqlanalytics\r\n",
					"from com.microsoft.spark.sqlanalytics.Constants import Constants\r\n",
					"from pyspark.sql import SparkSession\r\n",
					"\r\n",
					"accountName = 'adlsfhirnonprod'\r\n",
					"containerName = 'bronze'\r\n",
					"relativePath = '30tb'\r\n",
					"\r\n",
					"silverPath = \"abfss://silver@\" + accountName + \".dfs.core.windows.net/\" + relativePath"
				],
				"execution_count": 5
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					},
					"collapsed": false
				},
				"source": [
					"obsCategoryDf = spark.read.format(\"delta\").load(silverPath + \"/Observation_category\")\r\n",
					"obsComponentDf = spark.read.format(\"delta\").load(silverPath + \"/Observation_component\")\r\n",
					"obsCodeDf = spark.read.format(\"delta\").load(silverPath + \"/Observation_code\")\r\n",
					"patientIdDf = spark.read.format(\"delta\").load(silverPath + \"/Patient_identifier\")\r\n",
					"patientAddressDf = spark.read.format(\"delta\").load(silverPath + \"/Patient_address\")\r\n",
					"claimInsuranceDf = spark.read.format(\"delta\").load(silverPath + \"/Claim_insurance\")\r\n",
					"claimDiagnosisDf = spark.read.format(\"delta\").load(silverPath + \"/Claim_diagnosis\")\r\n",
					"claimProcedureDf = spark.read.format(\"delta\").load(silverPath + \"/Claim_procedure\")"
				],
				"execution_count": 9
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"claimInsuranceDf = claimInsuranceDf.withColumnRenamed(\"insurance_coverage.display\", \"insurance_coverage_display\")\r\n",
					"obsComponentDf = obsComponentDf.withColumnRenamed(\"Observation_id\", \"observation_id\")\r\n",
					"obsCodeDf = obsCodeDf.withColumnRenamed(\"Observation_id\", \"observation_id\")"
				],
				"execution_count": 12
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
						"outputs_hidden": false
					},
					"nteract": {
						"transient": {
							"deleting": false
						}
					}
				},
				"source": [
					"(obsCategoryDf.write\r\n",
					" .option(Constants.SERVER, \"wkspc-cdw-nonprod.sql.azuresynapse.net\")\r\n",
					" .option(Constants.TEMP_FOLDER, \"abfss://silver@adlsfhirnonprod.dfs.core.windows.net/sqlStaging\")\r\n",
