{
	"name": "dfcopySilver",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "lsadlsfhirnonprod",
						"type": "LinkedServiceReference"
					},
					"name": "claimMainDelta"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "lsdsqlnonprod",
						"type": "LinkedServiceReference"
					},
					"name": "fhirDW"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          claim_id as string,",
				"          resourceType as string,",
				"          status as string,",
				"          billablePeriod_end as string,",
				"          billablePeriod_start as string,",
				"          created as string,",
				"          patient_display as string,",
				"          patient_id_reference as string,",
				"          prescription_reference as string,",
				"          provider_display as string,",
				"          provider_org_id_reference as string,",
				"          total_currency as string,",
				"          total_value as double,",
				"          use as string,",
				"          year as integer,",
				"          month as string,",
				"          day as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 100,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     container: 'silver',",
				"     folderPath: '30tb/Claim_main/year=2021') ~> claimMainDelta",
				"claimMainDelta sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'synapseanalytics',",
				"     schemaName: 'fhir',",
				"     tableName: 'claimMain',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     allowCopyCommand: true,",
				"     staged: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> fhirDW"
			]
		}
	}
}